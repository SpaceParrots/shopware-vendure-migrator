# Copy to .env and fill in. The npm scripts load .env if it exists; variables already set in the
# shell take precedence. Variables are grouped by the stages that read them; all runs extract,
# transform, load and verify, so it reads every variable of those four. Each stage requires only
# the credentials it uses: transform none, extract the source database, load and verify Vendure,
# oracle the source database, Vendure and the Shopware API, all the source database and Vendure.
# An empty value counts as unset.

# --- extract, oracle: Shopware MySQL ---
# Host of the Shopware database; extract also writes it into the extract manifest.
SOURCE_DB_HOST=127.0.0.1
# Port of the Shopware database, an integer from 1 to 65535.
SOURCE_DB_PORT=3306
# Name of the Shopware database; extract also writes it into the extract manifest.
SOURCE_DB_NAME=shopware
# Database user; read access is enough. Required by extract, oracle and all.
SOURCE_DB_USER=changeme
# Password of that user. Required by extract, oracle and all.
SOURCE_DB_PASSWORD=changeme

# --- extract ---
# Free-text name of the source install, written into the extract manifest and from there into the verify report.
SOURCE_LABEL=unlabelled

# --- transform, oracle ---
# Public base URL of the shop. transform builds the image URLs load downloads from it, and oracle calls the Admin and Store API under it.
SOURCE_MEDIA_BASE_URL=http://localhost

# --- oracle: Shopware Admin and Store API ---
# Shopware admin user for the Admin API login. Required by oracle only.
SOURCE_ADMIN_USER=changeme
# Password of that admin user. Required by oracle only.
SOURCE_ADMIN_PASSWORD=changeme
# Store API access key of the storefront sales channel. Required by oracle only.
SOURCE_STORE_ACCESS_KEY=changeme

# --- load, verify, oracle: Vendure ---
# URL of the Vendure Admin API. bindings.json records it, and load, verify and oracle refuse to run against another URL.
VENDURE_ADMIN_API=http://localhost:3000/admin-api
# Vendure administrator identifier. Required by load, verify, oracle and all.
VENDURE_USERNAME=changeme
# Password of that administrator. Required by load, verify, oracle and all.
VENDURE_PASSWORD=changeme

# --- load-sales, verify-sales ---
# Path of the Vendure config module the target server runs with. load-sales boots Vendure in-process with it. Required by load-sales.
VENDURE_CONFIG=../vendure/src/vendure-config.js
# Password every migrated customer is expected to log in with; verify-sales skips the Shop API login checks when unset. Only for demo shops with one known password.
VERIFY_LOGIN_PASSWORD=changeme

# --- load, verify, oracle: HTTP ---
# Seconds one HTTP attempt may take, including reading the body, before it is aborted. A number, 1 or more.
MIGRATOR_HTTP_TIMEOUT_SECONDS=30
# Extra attempts after a timeout, network error or HTTP 408, 425, 429, 500, 502, 503 or 504. Only reads, logins and image downloads retry, never creates. Integer, 0 to 10.
MIGRATOR_HTTP_RETRIES=3

# --- verify ---
# Free-text name of the target install, written into the verify report.
TARGET_LABEL=unlabelled
# Minutes verify waits for the Vendure job queue to drain before it gives up. A number, 0 or more.
VERIFY_JOB_WAIT_MINUTES=45

# --- every stage ---
# Folder for snapshots and bindings.json, relative to the working directory.
MIGRATOR_OUT_DIR=out
