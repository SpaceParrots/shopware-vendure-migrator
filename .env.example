# Copy to .env and fill in. The npm scripts load .env if it exists; variables already set in the
# shell take precedence. Every stage needs the four required credentials, even transform, which
# does not connect to anything.

# --- Shopware MySQL (extract, oracle) ---
# Host of the Shopware database.
SOURCE_DB_HOST=127.0.0.1
# Port of the Shopware database.
SOURCE_DB_PORT=3306
# Name of the Shopware database.
SOURCE_DB_NAME=shopware
# Database user; read access is enough. Required.
SOURCE_DB_USER=changeme
# Password of that user. Required.
SOURCE_DB_PASSWORD=changeme

# --- Shopware HTTP (transform, load, oracle) ---
# Public base URL of the shop. Media URLs are built from it, and oracle calls the Admin and Store API under it.
SOURCE_MEDIA_BASE_URL=http://localhost
# Free-text name of the source install, written into the extract manifest and the verify report.
SOURCE_LABEL=unlabelled
# Shopware admin user for the Admin API login. Only oracle reads it.
SOURCE_ADMIN_USER=changeme
# Password of that admin user. Only oracle reads it.
SOURCE_ADMIN_PASSWORD=changeme
# Store API access key of the storefront sales channel. Only oracle reads it.
SOURCE_STORE_ACCESS_KEY=changeme

# --- Vendure (load, verify, oracle) ---
# URL of the Vendure Admin API.
VENDURE_ADMIN_API=http://localhost:3000/admin-api
# Vendure administrator identifier. Required.
VENDURE_USERNAME=changeme
# Password of that administrator. Required.
VENDURE_PASSWORD=changeme
# Free-text name of the target install, written into the verify report.
TARGET_LABEL=unlabelled
# Minutes verify waits for the Vendure job queue to drain before it gives up.
VERIFY_JOB_WAIT_MINUTES=45

# --- Output ---
# Folder for snapshots and bindings.json, relative to the working directory.
MIGRATOR_OUT_DIR=out
